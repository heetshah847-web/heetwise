# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/heetwise?schema=public"

# Secret used to sign JWT tokens. Use a long, random string.
JWT_SECRET="replace-with-a-long-random-secret"

# Lifetime of issued JWTs (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN="7d"

# Port the API server listens on
PORT=4000

# Origin of the frontend app, used for CORS + cookie settings
CLIENT_ORIGIN="http://localhost:5173"

# Allowed CORS origin(s) for the frontend. May be a single origin OR a
# comma-separated list to allow several (production domain + preview URLs), e.g.
#   FRONTEND_URL="https://heetwise.vercel.app,https://heetwise-wnkk.vercel.app"
# Requests from any origin not in the list are rejected with 403. Defaults to
# http://localhost:5173 for development.
FRONTEND_URL="http://localhost:5173"

# Node environment: development | production. In production the API returns only
# generic error messages (no stack traces) and uses secure cookie settings.
NODE_ENV="development"

# Auth rate limiting (defaults: 10 requests per 15 minutes per IP).
# Override to widen/narrow the limit without code changes.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Exchange-rate API key — SERVER-SIDE ONLY SECRET. Never expose it to the
# client bundle and never reference it outside backend/src/services/rateService.js.
# A free-tier key from Open Exchange Rates (openexchangerates.org) or Fixer.io
# works fine. The server will not start without this value.
# IMPORTANT: run `npm run sync-rates` once before starting the server the first
# time so the exchange_rates table is populated (non-USD expenses need it).
EXCHANGE_RATE_API_KEY="your-server-side-exchange-rate-api-key"

# Pusher (real-time updates) — SERVER-SIDE credentials from your Pusher Channels
# app dashboard. PUSHER_SECRET is a secret and must NEVER reach the client
# bundle. If these are left blank the app still runs and real-time broadcasts
# become no-ops (a full reload still shows the latest data).
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# Web Push (VAPID) — browser push notifications for unsettled debts, new
# expenses, invitations, and completed settlements. Generate a key pair with:
#   npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY is a SECRET and must never reach the client bundle. Add the
# same values to the Vercel backend environment. VITE_VAPID_PUBLIC_KEY (frontend)
# must equal VAPID_PUBLIC_KEY. If these are left blank, push becomes a no-op.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="admin@heetwise.app"
