# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/heetwise?schema=public"

# Secret used to sign JWT tokens. Use a long, random string.
JWT_SECRET="replace-with-a-long-random-secret"

# Lifetime of issued JWTs (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN="7d"

# Port the API server listens on
PORT=4000

# Origin of the frontend app, used for CORS + cookie settings
CLIENT_ORIGIN="http://localhost:5173"

# Node environment: development | production
NODE_ENV="development"
