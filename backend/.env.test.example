# Copy to .env.test. Integration tests TRUNCATE all tables between cases, so
# this MUST point at a throwaway database — never your dev/prod DB.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/heetwise_test?schema=public"

JWT_SECRET="test-secret"
JWT_EXPIRES_IN="1h"
NODE_ENV="test"

# Widen the auth rate limit so the integration auth suite (many requests from
# one IP) doesn't trip it. The limiter itself is covered by a dedicated test.
AUTH_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
