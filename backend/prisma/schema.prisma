// Prisma schema for Heetwise (smart expense splitting)
// All IDs are UUIDs, never integers.
// All money is stored as integer cents — never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through the pg driver adapter (src/lib/prisma.js). The
  // Prisma CLI (migrate/studio) reads its connection URL from prisma.config.ts.
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Smart-split relations
  groupsCreated   Group[]       @relation("GroupCreator")
  memberships     GroupMember[]
  expensesPaid    Expense[]     @relation("ExpensePayer")
  expensesCreated Expense[]     @relation("ExpenseCreator")
  splits          Split[]

  // Invitations + settlements
  invitationsSent     GroupInvitation[] @relation("InvitationInviter")
  invitationsReceived GroupInvitation[] @relation("InvitationInvitee")
  settlementsFrom     Settlement[]      @relation("SettlementFrom")
  settlementsTo       Settlement[]      @relation("SettlementTo")

  // Browser push notification subscriptions (one per device/browser).
  pushSubscriptions PushSubscription[]

  @@map("users")
}

// A group is a set of people who share expenses (e.g. a trip, a household).
model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  // Optional free-text description shown to invitees when they receive a
  // group invitation. Nullable; existing groups keep NULL.
  description String?
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     GroupMember[]
  expenses    Expense[]
  invitations GroupInvitation[]
  settlements Settlement[]

  @@index([createdById])
  @@map("groups")
}

// Join table: which users belong to which group. Access control is by membership.
model GroupMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  WEIGHT
}

// A single expense within a group, paid by one member, split among members.
model Expense {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  description String
  // amountCents is the CONVERTED base-currency (USD) amount, in cents. The
  // balance service reads only this, so it never changes for multi-currency.
  amountCents Int       @map("amount_cents")
  currency    String    @default("USD")
  // What the user actually typed, in `currency`, before conversion.
  originalAmount Decimal @default(0) @map("original_amount") @db.Decimal(14, 2)
  // The CUR->USD rate used at creation time (1 for USD).
  exchangeRate   Decimal @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  splitType   SplitType @default(EQUAL) @map("split_type")
  paidById    String    @map("paid_by_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy    User   @relation("ExpensePayer", fields: [paidById], references: [id])
  createdBy User   @relation("ExpenseCreator", fields: [createdById], references: [id])
  splits    Split[]

  @@index([groupId])
  @@index([paidById])
  @@map("expenses")
}

// How much each participant owes for a given expense.
// `amountCents` is the final, authoritative share (always set, in cents).
// `percentage` / `weight` record the raw input used to derive it for
// PERCENTAGE / WEIGHT splits (nullable; null for EQUAL / EXACT).
model Split {
  id          String   @id @default(uuid()) @db.Uuid
  expenseId   String   @map("expense_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  percentage  Decimal? @db.Decimal(7, 4)
  weight      Decimal? @db.Decimal(12, 4)
  // Set true once the debt this split represents has been settled (paid off)
  // via a Settlement. Settlement-aware balance surfaces exclude settled splits,
  // which is what makes a balance drop to zero after a "Settle up".
  isSettled   Boolean  @default(false) @map("is_settled")
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("splits")
}

// Cached exchange rates (CUR -> USD). Populated by the rateService cron job;
// never fetched inline during a request. `fetchedDate` (date-only) backs the
// "one rate per pair per day" unique constraint, while `fetchedAt` keeps the
// precise timestamp used to pick the most recent rate.
model ExchangeRate {
  id           String   @id @default(uuid()) @db.Uuid
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(18, 8)
  fetchedAt    DateTime @default(now()) @map("fetched_at")
  fetchedDate  DateTime @map("fetched_date") @db.Date

  @@unique([fromCurrency, toCurrency, fetchedDate])
  @@index([fromCurrency, toCurrency, fetchedAt])
  @@map("exchange_rates")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// An invitation asking someone (by email) to join a group. Replaces the old
// "add member directly" flow — a member is only added once they accept.
model GroupInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  groupId       String           @map("group_id") @db.Uuid
  invitedEmail  String           @map("invited_email")
  // Set when the invited email already matches a registered user (nullable —
  // you can invite someone who hasn't signed up yet).
  invitedUserId String?          @map("invited_user_id") @db.Uuid
  invitedById   String           @map("invited_by_id") @db.Uuid
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at")
  expiresAt     DateTime         @map("expires_at")

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("InvitationInviter", fields: [invitedById], references: [id])
  invitedUser User? @relation("InvitationInvitee", fields: [invitedUserId], references: [id])

  @@index([invitedEmail, status])
  @@index([groupId])
  @@map("group_invitations")
}

// A recorded payment settling a debt between two group members. Balances are
// still computed from expenses; settlements are the audit trail of who paid
// whom and drive the "unsettled debt" notifications.
model Settlement {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  fromUserId  String   @map("from_user_id") @db.Uuid
  toUserId    String   @map("to_user_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  currency    String   @default("USD")
  settledAt   DateTime @default(now()) @map("settled_at")
  createdAt   DateTime @default(now()) @map("created_at")

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([groupId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("settlements")
}

// A browser Web Push subscription for a user. One row per browser/device: the
// `endpoint` is globally unique, so re-subscribing the same browser upserts.
// Used by notificationService.sendPushNotification to reach a user's devices.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
