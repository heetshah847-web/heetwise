# Base URL of the backend API. Only VITE_-prefixed vars are exposed to the
# client bundle, and no secrets are ever placed here.
VITE_API_URL="http://localhost:4000"

# Pusher (real-time updates) — CLIENT-SAFE values only. These are the public
# app key and cluster; never put PUSHER_SECRET here. If unset, the app works
# without live updates (data still loads on navigation / refresh).
VITE_PUSHER_KEY=""
VITE_PUSHER_CLUSTER=""

# Web Push public (VAPID) key — CLIENT-SAFE. Must equal the backend's
# VAPID_PUBLIC_KEY. Used to subscribe the browser to push notifications. If
# unset, the app skips push subscription (everything else still works).
VITE_VAPID_PUBLIC_KEY=""
